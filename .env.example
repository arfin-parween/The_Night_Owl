# Copy to .env and fill in.
OPENSEARCH_VERSION=2.19.1
OPENSEARCH_URL=http://localhost:9200
DASHBOARDS_URL=http://localhost:5601

# OpenClaw Gateway webhook (hooks.enabled=true in ~/.openclaw/openclaw.json)
OPENCLAW_HOOK_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_HOOK_TOKEN=
OPENCLAW_AGENT_ID=main

# Where the agent's RCA is delivered (your Telegram user id with the bot)
TELEGRAM_CHAT_ID=
# Optional: lets the watcher send an instant "investigating..." ping from the same bot
TELEGRAM_BOT_TOKEN=
